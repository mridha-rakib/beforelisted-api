{
  "name": "before-listed-backend-api",
  "version": "2.0.0",
  "description": "Backend API for Before Listed application",
  "author": "Rakib Mahmud Mridha <rakibmahmudmridha.swe@gmail.com> (https://github.com/mridha-rakib)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [],
  "main": "src/index.ts",
  "scripts": {
    "start": "node -r ./tsconfig-paths-bootstrap.js dist/index.js",
    "start:local": "node --env-file=.env -r ./tsconfig-paths-bootstrap.js dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "npm run security:check && tsc && node scripts/copy-assets.js",
    "lint": "eslint --fix src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/security-check.mjs",
    "create:module": "node create-module.js",
    "seed:super-admin": "tsx --env-file=.env src/seeders/super-admin.seeder.ts",
    "backfill:grant-scope-at-match": "tsx --env-file=.env scripts/backfill-grant-scope-at-match.ts",
    "backfill:grant-scope-at-match:apply": "tsx --env-file=.env scripts/backfill-grant-scope-at-match.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^13.10.0",
    "glob": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.5",
    "mongoose-paginate-v2": "^1.9.5",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "postmark": "^4.0.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui": "^5.33.3",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "url": "^0.11.4",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-format": "1.1.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
